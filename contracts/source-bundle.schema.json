{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/chipk-capture/source-bundle-v1.json",
  "title": "ChipK Catalog Source Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "classification", "baseUrl", "routes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "pattern": ".*\\S.*" },
    "classification": { "enum": ["synthetic", "production-reviewed"] },
    "baseUrl": { "type": "string", "pattern": ".*\\S.*" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operations",
          "requiredParams",
          "optionalParams",
          "queryParams",
          "fixedParams",
          "readinessTexts"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^chipk\\.[A-Za-z0-9._-]+$" },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["screenshot", "record"] }
          },
          "requiredParams": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["stockId", "stockName", "recipeId"] }
          },
          "optionalParams": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["stockId", "stockName", "recipeId"] }
          },
          "queryParams": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "queryName"],
              "properties": {
                "name": { "enum": ["stockId", "stockName", "recipeId"] },
                "queryName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" }
              }
            }
          },
          "fixedParams": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
                "value": { "type": "string", "pattern": ".*\\S.*" }
              }
            }
          },
          "readinessTexts": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": ".*\\S.*" }
          }
        }
      }
    }
  }
}
