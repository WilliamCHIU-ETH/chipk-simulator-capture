{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/chipk-capture/result-v1.json",
  "title": "ChipK Capture Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "provider", "status", "artifacts", "evidence", "error"],
  "properties": {
    "contractVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": ".*\\S.*" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "toolVersion"],
      "properties": {
        "id": { "const": "chipk-simulator-capture" },
        "toolVersion": { "type": "string", "pattern": ".*\\S.*" }
      }
    },
    "status": { "enum": ["completed", "rejected", "failed", "human_action_required"] },
    "artifacts": { "type": "object" },
    "evidence": { "type": "object" },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": ".*\\S.*" },
        "message": { "type": "string", "pattern": ".*\\S.*" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
